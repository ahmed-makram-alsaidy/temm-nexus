# NOTE: values containing spaces MUST be quoted. An unquoted
# `APP_NAME=TEMM Nexus` makes Laravel's dotenv parser throw
# "Encountered unexpected whitespace", so a fresh `composer setup` fails at
# `artisan key:generate`. Fixed in 0.4.0.
APP_NAME="TEMM Nexus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Nexus AI transport telemetry (0.4.0-rc.7) ────────────────────────────
# Safe wire diagnostics (URL, method, status, Content-Type, effective
# User-Agent, JSON field names, stream) into storage/logs/nexus-ai.log.
# Never logs Authorization or the API key.
NEXUS_AI_TELEMETRY=true
NEXUS_AI_TELEMETRY_CHANNEL=nexus-ai
NEXUS_AI_TELEMETRY_LEVEL=debug
# Local development ONLY: permit http://127.0.0.1 AI base URLs so the
# acceptance flow can run against scripts/mock-agentrouter.php offline.
# NEVER enable in production.
AI_ALLOW_LOOPBACK_ENDPOINTS=false

# ── Developer Agent runtime (Phase 43) ─────────────────────────────────
# Managed OpenCode endpoint + shared basic-auth password (same value as the
# root .env used by the compose stack). See docs/agent-runtime/DEVELOPER_AGENT.md.
OPENCODE_MANAGED_ENDPOINT=http://opencode:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=CHANGE_ME_32CHAR_MIN
AGENT_ALLOW_LOOPBACK_ENDPOINTS=false
AGENT_MAX_EVENTS=500
AGENT_MAX_DIFF_BYTES=512000
AGENT_WORKSPACE_RETENTION_DAYS=7
