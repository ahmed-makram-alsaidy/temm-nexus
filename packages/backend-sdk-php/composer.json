{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "platform/backend-sdk",
    "description": "Official server-to-server PHP client for TEMM Nexus (API v1). No runtime dependencies (ext-curl only).",
    "type": "library",
    "license": "AGPL-3.0-only",
    "version": "0.1.0",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Platform\\BackendSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Platform\\BackendSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run-tests.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
