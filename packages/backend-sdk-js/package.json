{
  "name": "@platform/backend-sdk",
  "version": "0.1.1",
  "description": "Official TypeScript client for TEMM Nexus (API v1). Dependency-free, fetch-based.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "devDependencies": {
    "@types/node": "22.7.4",
    "typescript": "5.6.3"
  }
}
