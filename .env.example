# ═══════════════════════════════════════════════════════════════════
#  PLATFORM — SELF-HOSTED BACKEND & MIGRATION CONTROL PLANE
#  Environment template. Copy to `.env` and fill in real values.
#  NEVER commit a real .env. Never reuse placeholder passwords.
#  `scripts/install.sh` can generate safe secrets for you.
# ═══════════════════════════════════════════════════════════════════

# ── PLATFORM ───────────────────────────────────────────────────────
# Generic branding (safe defaults; override to your own identity).
PLATFORM_NAME=TEMM Nexus
BRAND_NAME=TEMM Nexus
SUPPORT_URL=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Generate: docker compose exec app php artisan key:generate --show
APP_KEY=
APP_MAINTENANCE_DRIVER=file
COMPOSE_PROJECT_NAME=backend-plane
TZ=UTC

# ── DATABASE (PostgreSQL — platform database) ──────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=owner_console
DB_USERNAME=owner_console
DB_PASSWORD=CHANGE_ME_32CHAR_MIN

# Postgres container bootstrap (superuser; applied on FIRST init only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_32CHAR_MIN
POSTGRES_DB=postgres

# Read-only monitoring connection (Pulse/metrics; may reuse main creds)
MONITOR_DB_HOST=postgres
MONITOR_DB_PORT=5432
MONITOR_DB_DATABASE=owner_console
MONITOR_DB_USERNAME=owner_console
MONITOR_DB_PASSWORD=CHANGE_ME_32CHAR_MIN

# ── REDIS (cache, queues, rate limiters; internal-only) ────────────
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_32CHAR_MIN
REDIS_PORT=6379
CACHE_STORE=database
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

# ── HTTP / HTTPS (edge) ────────────────────────────────────────────
# Public ports published by the edge (Caddy). Only 80/443 should ever be
# publicly exposed; everything else stays on the internal Docker network.
HTTP_PORT=80
HTTPS_PORT=443
# Your domain (automatic HTTPS via Caddy + Let's Encrypt) — e.g. panel.example.com
# Leave empty to bootstrap over plain HTTP on an IP address (documented limits apply).
# PRIMARY_DOMAIN=panel.example.com  (comment out while bootstrapping on an IP)
TRUSTED_PROXIES=*

# ── STORAGE ────────────────────────────────────────────────────────
# Public project storage lives under the container path below (named volume).
PROJECT_STORAGE_DISK=local
FILESYSTEM_DISK=local

# ── QUEUE (Horizon) ────────────────────────────────────────────────
HORIZON_NAME=control-plane
HORIZON_PATH=horizon

# ── REALTIME (Reverb websockets) ───────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=control-plane
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public hostname clients use for websocket connections (defaults to APP_URL host).
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

# ── MAIL (optional — platform works without it) ────────────────────
# Leave MAIL_MAILER=log when no SMTP is available; mail-dependent features
# report NOT CONFIGURED instead of failing.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=platform@localhost
MAIL_FROM_NAME="${PLATFORM_NAME}"

# ── BACKUP ─────────────────────────────────────────────────────────
# Backup destination defaults; configure Backup Center in the admin UI.
BACKUP_STAGING_DIR=/backups

# ── AI (BRING YOUR OWN KEY — optional; platform works without it) ──
# Configure providers in the admin UI (AI Migration Copilot). Keys are stored
# encrypted at rest. NOTHING here ships a key.
AI_ENABLED=false

# ── SECURITY ───────────────────────────────────────────────────────
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SANCTUM_STATEFUL_DOMAINS=
# Set to a real address reachable by security researchers before public launch.
SECURITY_CONTACT=

# ── OBSERVABILITY ──────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=info
PULSE_ENABLED=true
PULSE_VIEWS_ENABLED=false

# ── LOCAL DEVELOPMENT ONLY (never enable in production) ────────────
# Optional dev tooling profiles (pgAdmin/Mailpit) are disabled by default;
# see docker-compose.yml `profiles:` and docs/SELF_HOSTING.md.
ENABLE_DEMO_SEED=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_HTTP_PORT=5051
MAILPIT_HTTP_PORT=8026
MAILPIT_SMTP_PORT=1026
